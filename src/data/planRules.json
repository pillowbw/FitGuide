  "scienceNote": "依据研究：每周每肌群训练约 2 次更利于增肌（Schoenfeld et al., 2016）。业余用 3 日全身轮换练动作模式；进阶用 4 日上肢/下肢 A·B，同一肌群两次刺激、动作不雷同。",
  "restDayHints": [
    "保证 7–9 小时睡眠，恢复比硬练更重要",
    "可做 20–30 分钟步行、轻度拉伸或泡沫轴",
    "同一肌群两次训练间隔约 48–72 小时，不要连日狂轰同一部位"
  ],
  "postWorkoutStretchNote": "练后针对今日发力部位做静态拉伸：缓慢进入、不弹振，有紧但不痛；左右两侧各做一遍。",
  "postWorkoutStretches": {
    "chest": {
      "position": "胸大肌（胸前侧）",
      "cue": "侧立门框，前臂贴门框，躯干缓慢外旋至胸部有拉伸感",
      "holdSeconds": 30,
      "videoUrl": "https://www.youtube.com/watch?v=B9uY01NoqBg"
    },
    "shoulders": {
      "position": "三角肌（肩部）",
      "cue": "一臂横过胸前，另一手轻拉上臂，感受肩外侧与后侧拉伸",
      "holdSeconds": 30,
      "videoUrl": "https://www.youtube.com/watch?v=-1K0m5ywRcY"
    },
    "biceps": {
      "position": "肱二头肌（上臂前侧）",
      "cue": "手臂伸直手掌贴墙，身体略转离墙壁至上臂前侧拉伸",
      "holdSeconds": 25,
      "videoUrl": "https://us.physitrack.com/home-exercise-video/bicep-stretch-against-wall"
    },
    "triceps": {
      "position": "肱三头肌（上臂后侧）",
      "cue": "一手过头屈肘摸上背，另一手轻压肘尖向下",
      "holdSeconds": 30,
      "videoUrl": "https://grabgains.com/exercises/overhead-triceps-stretch"
    },
    "forearms": {
      "position": "前臂屈肌（腕内侧）",
      "cue": "手臂前伸掌心向上，另一手轻压手指向下至前臂内侧拉伸",
      "holdSeconds": 20,
      "videoUrl": "https://www.youtube.com/watch?v=oQpskjE937M"
    },
    "lats": {
      "position": "背阔肌（侧背）",
      "cue": "单手高抓固定物，髋向对侧推，侧肋与侧背拉长",
      "holdSeconds": 30,
      "videoUrl": "https://www.peak-physio.com.au/exercise/doorway-lat-stretch/"
    },
    "traps": {
      "position": "斜方肌（颈肩交界）",
      "cue": "坐直，一手轻按头顶侧向对侧倾，对侧肩下沉",
      "holdSeconds": 25,
      "videoUrl": "https://www.youtube.com/watch?v=-r0eoFS7_5Q"
    },
    "abs": {
      "position": "腹直肌（腹部）",
      "cue": "俯卧撑起上身做眼镜蛇式，骨盆贴地，腹部轻柔拉伸",
      "holdSeconds": 25,
      "videoUrl": "https://www.youtube.com/watch?v=JDcdhTuycOI"
    },
    "obliques": {
      "position": "腹斜肌（腰侧）",
      "cue": "站姿或跪姿向一侧侧屈，对侧腰线拉长，勿塌腰",
      "holdSeconds": 25,
      "videoUrl": "https://www.youtube.com/watch?v=xt7-316u0M4"
    },
    "lowerback": {
      "position": "竖脊肌（下背部）",
      "cue": "仰卧抱膝向胸，或猫牛式缓慢拱背，感受腰背舒展",
      "holdSeconds": 30,
      "videoUrl": "https://www.youtube.com/watch?v=Yd9wY25koVk"
    },
    "quads": {
      "position": "股四头肌（大腿前侧）",
      "cue": "站立单脚，手握同侧脚踝拉向臀部，膝朝下、髋前推",
      "holdSeconds": 30,
      "videoUrl": "https://www.youtube.com/watch?v=kzAsm4WQqvQ"
    },
    "hamstrings": {
      "position": "腘绳肌（大腿后侧）",
      "cue": "一腿前伸足跟着地，髋后坐、脊柱延长，感受大腿后侧",
      "holdSeconds": 30,
      "videoUrl": "https://www.youtube.com/watch?v=LVY692zJK0A"
    },
    "glutes": {
      "position": "臀大肌（臀部）",
      "cue": "仰卧，踝搭对侧膝做数字4，轻拉支撑腿向胸",
      "holdSeconds": 30,
      "videoUrl": "https://www.youtube.com/watch?v=Xb5gHdYtHnk"
    },
    "calves": {
      "position": "小腿三头肌（小腿后侧）",
      "cue": "弓步踩墙或台阶，后脚跟下压，膝伸直与微屈各做一组",
      "holdSeconds": 30,
      "videoUrl": "https://www.youtube.com/watch?v=DfYaC807e94"
    }
  },
