# 复制为 .env.local 后填写密钥，并重启 npm run dev
# 未填写 OPENAI_API_KEY 时只会走「模板演示」，不是真实 AI

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 可选：兼容 OpenAI 协议的中转/国产模型，例如 DeepSeek：
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash

# true=无 Key 时允许模板演示；配好 Key 后会自动走真实模型
FITGUIDE_COACH_DEMO=true
